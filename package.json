{
  "name": "the-results-business",
  "version": "2.0.0",
  "private": true,
  "description": "A mobile-first football management career game.",
  "scripts": {
    "serve": "node scripts/serve.cjs",
    "lint": "eslint src tests scripts service-worker.js",
    "test": "node --test --test-reporter=spec --test-concurrency=2",
    "sweep": "node scripts/sweep-screens.cjs",
    "check": "npm run lint && npm test",
    "framed": "node scripts/check-framed.cjs",
    "upload": "node scripts/build-upload.cjs",
    "play": "node scripts/play-career.cjs",
    "android:check": "node scripts/check-android-shell.cjs",
    "apk": "cd android && ./gradlew --no-daemon assembleRelease",
    "aab": "cd android && ./gradlew --no-daemon bundleRelease"
  },
  "devDependencies": {
    "eslint": "^9.33.0",
    "fake-indexeddb": "^6.2.2",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0"
  }
}
